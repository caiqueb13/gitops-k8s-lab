      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "targets": [
        {
          "expr": "lab_kyverno_installation_state",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "lab_flux_installed",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "lab_flux_healthy",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "id": 4,
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "Value": "Kyverno state",
              "Value #B": "Flux installed",
              "Value #C": "Flux healthy"
            }
          }
        }
      ]
    },
