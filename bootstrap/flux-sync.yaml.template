apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: lab-config
  namespace: flux-system
spec:
  interval: 1m
  url: __GIT_URL__
  ref:
    branch: main
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: kyverno
  namespace: flux-system
spec:
  interval: 5m
  path: ./apps/kyverno
  prune: true
  sourceRef:
    kind: GitRepository
    name: lab-config
